# Copie ce fichier en .env.local et remplis les valeurs. Ne le partage jamais.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta > Graph API Explorer, token d'accès utilisateur (après la vérification d'identité Ad Library)
META_ACCESS_TOKEN=
META_API_VERSION=v27.0
# Pays UE où chercher (codes ISO, séparés par des virgules)
META_COUNTRIES=FR,DE,NL,BE,ES,IT,SE,DK,IE,AT
# Max de pubs par mot-clé par collecte
META_MAX_PER_TERM=500

# Clé API Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Classement : rules (gratuit), hybrid (règles + Claude pour les « Autre »), ai (tout par Claude)
CLASSIFY_MODE=rules
# Modèle pour la classification (claude-haiku-5-5 coûte ~40x moins cher)
CLASSIFY_MODEL=claude-haiku-5-5
CLASSIFY_BATCH=20
